<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="always" />

    <!-- External Player Button -->
    <ImageButton
        android:id="@+id/buttonExternalPlayer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_share"
        android:contentDescription="@string/settings"
        app:tint="#FFFFFF"
        android:alpha="0.8" />

    <!-- Player Settings Button -->
    <ImageButton
        android:id="@+id/buttonPlayerSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/buttonExternalPlayer"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="@string/player_settings"
        app:tint="#FFFFFF"
        android:alpha="0.8" />

    <!-- Speech Recognition / Voice Translation Button at Top -->
    <ImageButton
        android:id="@+id/buttonPlayerVoiceStt"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/buttonPlayerSettings"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="التعرف الصوتي والترجمة"
        app:tint="#FFEB3B"
        android:alpha="0.9" />

    <!-- Real-time Subtitles / Recognized Text at Bottom (Yellow color, 12sp) -->
    <TextView
        android:id="@+id/textPlayerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:textColor="#FFEB3B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="gone" />

</RelativeLayout>
